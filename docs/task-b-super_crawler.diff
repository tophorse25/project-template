new file mode 100644
index 0000000..0810e7c
--- /dev/null
+++ b/tests/test_planner.py
@@ -0,0 +1,126 @@
+"""Task B — LLM search planner with deterministic fallback.
+
+Tests use a fake LLM client (no network, no Ollama needed) so they run anywhere.
+The contract under test: plans are produced and persisted with either engine, the
+planner reads deep-research feedback, and an unavailable model degrades to the
+heuristic plan instead of failing.
+"""
+
+from __future__ import annotations
+
+import json
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+
+from super_crawler.agents import DeepResearchAgent, DiscoveryAgent, PoolManagerAgent, SearchPlannerAgent
+from super_crawler.cli import plan_to_crawl_config
+from super_crawler.dashboard import search_plan_block
+from super_crawler.llm import LLMUnavailable
+from super_crawler.seed import SAMPLE_REDDIT_ITEMS
+from super_crawler.storage import Storage
+
+
+class FakeLLM:
+    def __init__(self):
+        self.prompts: list[str] = []
+
+    def generate_json(self, prompt: str, system: str | None = None) -> dict:
+        self.prompts.append(prompt)
+        return {
+            "dimensions": ["tool requests", "complaints"],
+            "queries": [
+                {"query": "is there an app for dog medication schedules", "rationale": "tool request"},
+                "dog medication tracking frustrating",
+            ],
+            "sources": ["r/dogs", "r/AskVet"],
+            "negative_keywords": ["human medication"],
+            "validation_hypotheses": ["owners of multiple pets feel the pain most"],
+        }
+
+    def engine_name(self) -> str:
+        return "fake:test-model"
+
+
+class FailingLLM:
+    def generate_json(self, prompt: str, system: str | None = None) -> dict:
+        raise LLMUnavailable("server down")
+
+    def engine_name(self) -> str:
+        return "fake:down"
+
+
+class PlannerTests(unittest.TestCase):
+    def _storage(self) -> Storage:
+        directory = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, directory, True)
+        storage = Storage(Path(directory) / "test.sqlite3")
+        storage.migrate()
+        self.addCleanup(storage.close)
+        return storage
+
+    def test_llm_plan_is_saved_with_engine_and_coerced_queries(self) -> None:
+        storage = self._storage()
+        fake = FakeLLM()
+        plan = SearchPlannerAgent(storage, "planner-1", fake).plan(goal="dog medication tracking")
+
+        saved = storage.latest_search_plan()
+        self.assertIsNotNone(saved)
+        self.assertEqual(saved.plan_id, plan.plan_id)
+        self.assertEqual(saved.engine, "fake:test-model")
+        # Mixed string/dict queries are coerced to {"query", "rationale"} dicts.
+        self.assertTrue(all(isinstance(item, dict) and item.get("query") for item in saved.queries))
+        self.assertEqual(len(saved.queries), 2)
+        self.assertIn("r/dogs", saved.sources)
+
+    def test_feedback_from_deep_research_reaches_the_prompt(self) -> None:
+        storage = self._storage()
+        DiscoveryAgent(storage, "discovery").ingest_reddit_items(SAMPLE_REDDIT_ITEMS)
+        PoolManagerAgent(storage, "pool").reconcile_candidates()
+        while DeepResearchAgent(storage, "worker").run_next() is not None:
+            pass  # research everything so there are real outcomes
+
+        fake = FakeLLM()
+        plan = SearchPlannerAgent(storage, "planner-1", fake).plan(goal="pet care requirements")
+
+        self.assertIn("outcomes so far", plan.feedback_summary)
+        self.assertIn("outcomes so far", fake.prompts[0])  # feedback is in the LLM prompt
+
+    def test_unavailable_llm_falls_back_to_heuristic_plan(self) -> None:
+        storage = self._storage()
+        plan = SearchPlannerAgent(storage, "planner-1", FailingLLM()).plan(goal="dog medication tracking")
+
+        self.assertEqual(plan.engine, "heuristic")
+        self.assertTrue(plan.queries)
+        self.assertIsNotNone(storage.latest_search_plan())
+
+    def test_no_client_also_falls_back(self) -> None:
+        storage = self._storage()
+        plan = SearchPlannerAgent(storage, "planner-1", client=None).plan(goal="anything")
+        self.assertEqual(plan.engine, "heuristic")
+
+    def test_plan_exports_collector_crawl_config(self) -> None:
+        storage = self._storage()
+        plan = SearchPlannerAgent(storage, "planner-1", FakeLLM()).plan(goal="dog medication tracking")
+        directory = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, directory, True)
+
+        path = plan_to_crawl_config(plan, str(Path(directory) / "cfg.json"))
+        config = json.loads(Path(path).read_text(encoding="utf-8"))
+
+        self.assertEqual(config["product"], "dog medication tracking")
+        self.assertIn("is there an app for dog medication schedules", config["queries"])
+        self.assertTrue(config["output_path"].endswith(".jsonl"))
+
+    def test_dashboard_block_renders_plan(self) -> None:
+        storage = self._storage()
+        SearchPlannerAgent(storage, "planner-1", FakeLLM()).plan(goal="dog medication tracking")
+        html = search_plan_block(storage)
+        self.assertIn("Search Plan", html)
+        self.assertIn("fake:test-model", html)
+        self.assertIn("is there an app for dog medication schedules", html)
+
+
+if __name__ == "__main__":
+    unittest.main()
