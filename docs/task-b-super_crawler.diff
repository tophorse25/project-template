diff --git a/super_crawler/llm.py b/super_crawler/llm.py
new file mode 100644
index 0000000..ff121fd
--- /dev/null
+++ b/super_crawler/llm.py
@@ -0,0 +1,81 @@
+"""Optional local-LLM client (Ollama) for the search planner.
+
+Dependency-light by design: stdlib urllib only, no API key, talks to a local
+Ollama server. The rest of the system never *requires* this — every caller must
+catch ``LLMUnavailable`` and fall back to deterministic behavior, so the agent
+keeps running when no model is installed (the deck's reliability bar).
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import urllib.error
+import urllib.request
+from typing import Any
+
+DEFAULT_OLLAMA_URL = os.environ.get("OLLAMA_URL", "http://127.0.0.1:11434")
+DEFAULT_MODEL_ENV = "OLLAMA_MODEL"
+
+
+class LLMUnavailable(RuntimeError):
+    """Raised when no usable local model can be reached. Callers must degrade gracefully."""
+
+
+class OllamaClient:
+    def __init__(self, base_url: str = DEFAULT_OLLAMA_URL, model: str | None = None, timeout: float = 120.0):
+        self.base_url = base_url.rstrip("/")
+        self.model = model or os.environ.get(DEFAULT_MODEL_ENV)
+        self.timeout = timeout
+
+    def available_models(self) -> list[str]:
+        try:
+            with urllib.request.urlopen(f"{self.base_url}/api/tags", timeout=5) as response:
+                payload = json.loads(response.read().decode("utf-8"))
+        except (urllib.error.URLError, OSError, ValueError) as exc:
+            raise LLMUnavailable(f"Ollama not reachable at {self.base_url}: {exc}") from exc
+        return [item.get("name", "") for item in payload.get("models", [])]
+
+    def resolve_model(self) -> str:
+        if self.model:
+            return self.model
+        models = self.available_models()
+        if not models:
+            raise LLMUnavailable("Ollama is running but no models are pulled (try: ollama pull qwen2.5:3b)")
+        return models[0]
+
+    def generate_json(self, prompt: str, system: str | None = None) -> dict[str, Any]:
+        """Run one chat turn in JSON mode and parse the result into a dict."""
+
+        model = self.resolve_model()
+        messages = []
+        if system:
+            messages.append({"role": "system", "content": system})
+        messages.append({"role": "user", "content": prompt})
+        body = json.dumps(
+            {"model": model, "messages": messages, "format": "json", "stream": False,
+             "options": {"temperature": 0.2}}
+        ).encode("utf-8")
+        request = urllib.request.Request(
+            f"{self.base_url}/api/chat", data=body, headers={"Content-Type": "application/json"}
+        )
+        try:
+            with urllib.request.urlopen(request, timeout=self.timeout) as response:
+                payload = json.loads(response.read().decode("utf-8"))
+        except (urllib.error.URLError, OSError) as exc:
+            raise LLMUnavailable(f"Ollama call failed: {exc}") from exc
+
+        content = payload.get("message", {}).get("content", "")
+        try:
+            parsed = json.loads(content)
+        except ValueError as exc:
+            raise LLMUnavailable(f"Model returned non-JSON output: {content[:200]}") from exc
+        if not isinstance(parsed, dict):
+            raise LLMUnavailable("Model returned JSON that is not an object")
+        return parsed
+
+    def engine_name(self) -> str:
+        try:
+            return f"ollama:{self.resolve_model()}"
+        except LLMUnavailable:
+            return "ollama:unresolved"
