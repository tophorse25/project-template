@@ -0,0 +1,52 @@
+"""Signal-pattern recall, driven by real crawl evidence.
+
+On 2026-06-11 a live crawl of 64 Reddit titles (returned for LLM-planned queries about
+pet medication tracking) produced ZERO discovery matches — the original patterns did not
+cover how users actually phrase these posts. Every fixture below is a real title from
+that crawl; this test pins the recall fix so it cannot regress.
+"""
+
+from __future__ import annotations
+
+import unittest
+
+from super_crawler.text import matched_signal_patterns
+
+REAL_TITLES_THAT_MUST_MATCH = [
+    "App for keeping track of dog meds?",
+    "How do you keep track of you dog's medications / vaccines?",
+    "what do most pet owners actually do to track daily meds at home",
+    "I'm a dev building a medication tracker for pets. What features do you actually need?",
+    "How do you organize complex meds for a senior pet when someone else has to help?",
+    "how do i give my dog a daily medicine for the rest of his life?",
+    "What app to log your pet condition regularly, i.e. weight, medication, etc.",
+    "We built an app to manage pet meds, records, and emergencies. What are we missing?",
+    "Best tracking for pets!",
+    "Advice on medication schedule (automation) for dog?",
+    "I just use Gmail calendar tasks/events/reminders - you can choose email or push",
+    "They ended up getting one of those weekly pill organizers but kept it up high",
+    "I built an iPhone app to help dog owners organize care routines and medications",
+]
+
+NEUTRAL_TITLES_THAT_MUST_NOT_MATCH = [
+    "My dog enjoyed the beach today",
+    "Look at this sunset from my balcony",
+    "Happy birthday to our golden retriever",
+]
+
+
+class SignalPatternRecallTests(unittest.TestCase):
+    def test_real_crawl_titles_are_detected(self) -> None:
+        missed = [title for title in REAL_TITLES_THAT_MUST_MATCH if not matched_signal_patterns(title)]
+        self.assertEqual(missed, [], f"patterns missed {len(missed)} real requirement titles")
+
+    def test_neutral_titles_stay_unmatched(self) -> None:
+        false_positives = [title for title in NEUTRAL_TITLES_THAT_MUST_NOT_MATCH if matched_signal_patterns(title)]
+        self.assertEqual(false_positives, [], "patterns matched clearly neutral titles")
+
+    def test_builder_activity_is_its_own_signal(self) -> None:
+        self.assertIn("builder_activity", matched_signal_patterns("I built an app to track my dog's meds"))
+
+
+if __name__ == "__main__":
+    unittest.main()
