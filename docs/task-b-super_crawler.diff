+_PLANNER_SYSTEM = (
+    "You are the search planner for a Reddit requirement-discovery system. "
+    "You turn a research goal into a concrete search strategy. "
+    "Respond with STRICT JSON only - one object, no prose."
+)
+
+
+class SearchPlannerAgent(BaseAgent):
+    """Plans the next search round: dimensions, queries, sources, hypotheses.
+
+    Uses a local LLM (Ollama) when one is reachable, and reads deep-research
+    feedback so each round converges (which sources were noisy, what got
+    rejected and why). Falls back to a deterministic template plan when no
+    model is available, so the system never stalls on a missing dependency.
+    """
+
+    role = "search_planner"
+
+    def __init__(self, storage: Storage, agent_id: str, client=None):
+        super().__init__(storage, agent_id)
+        self.client = client
+
+    def plan(self, task_group=None, goal: str | None = None) -> SearchPlan:
+        goal_text = goal or (
+            f"{task_group.domain or task_group.name} user requirements" if task_group else "general user requirements"
+        )
+        feedback = self._feedback_summary(task_group)
+        try:
+            if self.client is None:
+                raise LLMUnavailable("no LLM client configured")
+            raw = self.client.generate_json(self._prompt(goal_text, task_group, feedback), system=_PLANNER_SYSTEM)
+            plan = self._coerce(raw, goal_text, task_group, feedback, engine=self.client.engine_name())
+            self.log("plan", "completed", [task_group.task_group_id] if task_group else [], [plan.plan_id])
+        except LLMUnavailable as exc:
+            plan = self._heuristic_plan(goal_text, task_group, feedback)
+            self.log("plan", "fallback_heuristic", [task_group.task_group_id] if task_group else [], [plan.plan_id], str(exc))
+        self.storage.upsert_search_plan(plan)
+        return plan
+
+    def _feedback_summary(self, task_group) -> str:
+        requirements = self.storage.list_requirements()
+        if task_group is not None:
+            requirements = [r for r in requirements if task_group.task_group_id in r.task_group_ids]
+        if not requirements:
+            return "No prior outcomes yet; this is the first search round."
+
+        by_status: Counter[str] = Counter(r.status.value for r in requirements)
+        noisy_sources: Counter[str] = Counter()
+        rejection_reasons: list[str] = []
+        for requirement in requirements:
+            if requirement.status != RequirementStatus.REJECTED:
+                continue
+            for item in self.storage.list_evidence(requirement.evidence_ids):
+                noisy_sources[item.subreddit] += 1
+            runs = self.storage.list_research_runs(requirement.requirement_id)
+            if runs and len(rejection_reasons) < 5:
+                rejection_reasons.append(f"{requirement.canonical_requirement[:60]}: {runs[0].findings.get('why_noise', '')}")
+
+        parts = [f"outcomes so far: {dict(by_status)}"]
+        if noisy_sources:
+            noisy = ", ".join(f"{source} ({count} rejected)" for source, count in noisy_sources.most_common(3))
+            parts.append(f"noisier sources: {noisy}")
+        if rejection_reasons:
+            parts.append("rejection reasons: " + " | ".join(rejection_reasons))
+        return "; ".join(parts)
+
+    def _prompt(self, goal: str, task_group, feedback: str) -> str:
+        keywords = ", ".join(task_group.keywords) if task_group and task_group.keywords else "none given"
+        sources = ", ".join(task_group.subreddits) if task_group and task_group.subreddits else "none given"
+        return (
+            f"Research goal: discover real user requirements about: {goal}\n"
+            f"Known keywords: {keywords}\n"
+            f"Sources already searched: {sources}\n"
+            f"Feedback from previous rounds: {feedback}\n\n"
+            "Plan the next search round. Queries must be phrased the way real Reddit users write "
+            "(tool requests, frustration, workarounds, alternatives) - not like marketing keywords. "
+            "Use the feedback: avoid noisy sources, do not repeat query styles that produced rejected "
+            "requirements, and propose hypotheses deep research should test.\n\n"
+            "Return JSON exactly in this shape:\n"
+            "{\n"
+            '  "dimensions": ["3-5 search angles"],\n'
+            '  "queries": [{"query": "search text", "rationale": "why"}],\n'
+            '  "sources": ["r/subreddit names to prioritize"],\n'
+            '  "negative_keywords": ["terms that mark noise"],\n'
+            '  "validation_hypotheses": ["claims deep research should verify"]\n'
+            "}\n"
+            "Give 4 to 8 queries."
+        )
+
+    def _coerce(self, raw: dict, goal: str, task_group, feedback: str, engine: str) -> SearchPlan:
+        queries: list[dict[str, str]] = []
+        for item in raw.get("queries", [])[:10]:
+            if isinstance(item, str):
+                queries.append({"query": item, "rationale": ""})
+            elif isinstance(item, dict) and item.get("query"):
+                queries.append({"query": str(item["query"]), "rationale": str(item.get("rationale", ""))})
+        if not queries:
+            raise LLMUnavailable("model returned no usable queries")
+
+        def str_list(key: str, cap: int = 8) -> list[str]:
+            return [str(value) for value in raw.get(key, []) if str(value).strip()][:cap]
+
+        return self._build_plan(goal, task_group, feedback, engine, str_list("dimensions"), queries,
+                                str_list("sources"), str_list("negative_keywords"), str_list("validation_hypotheses"))
+
+    def _heuristic_plan(self, goal: str, task_group, feedback: str) -> SearchPlan:
+        seeds = (task_group.keywords if task_group and task_group.keywords else [goal])[:3]
+        queries = []
+        for seed in seeds:
+            queries.extend(
+                [
+                    {"query": f"is there a tool for {seed}", "rationale": "tool-request signal"},
+                    {"query": f"{seed} frustrating", "rationale": "complaint signal"},
+                    {"query": f"alternatives to {seed}", "rationale": "alternative-seeking signal"},
+                ]
+            )
+        return self._build_plan(
+            goal,
+            task_group,
+            feedback,
+            "heuristic",
+            ["tool requests", "complaints", "workarounds", "alternatives"],
+            queries[:8],
+            list(task_group.subreddits) if task_group and task_group.subreddits else [],
+            list(task_group.negative_keywords) if task_group and task_group.negative_keywords else [],
+            ["the pain appears in more than one subreddit", "users mention paying for a workaround"],
+        )
+
+    def _build_plan(self, goal, task_group, feedback, engine, dimensions, queries, sources, negative, hypotheses) -> SearchPlan:
+        created_at = utc_now()
+        plan_id = "plan_" + hashlib.sha1(f"{goal}|{engine}|{created_at}".encode()).hexdigest()[:12]
+        return SearchPlan(
+            plan_id=plan_id,
+            task_group_id=task_group.task_group_id if task_group else None,
+            goal=goal,
+            engine=engine,
+            dimensions=dimensions,
+            queries=queries,
+            sources=sources,
+            negative_keywords=negative,
+            validation_hypotheses=hypotheses,
+            feedback_summary=feedback,
+            created_at=created_at,
+        )
+
+
