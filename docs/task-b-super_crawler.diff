@@ -0,0 +1,126 @@
+"""Task B — LLM search planner with deterministic fallback.
+
+Tests use a fake LLM client (no network, no Ollama needed) so they run anywhere.
+The contract under test: plans are produced and persisted with either engine, the
+planner reads deep-research feedback, and an unavailable model degrades to the
+heuristic plan instead of failing.
+"""
+
+from __future__ import annotations
+
+import json
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+
+from super_crawler.agents import DeepResearchAgent, DiscoveryAgent, PoolManagerAgent, SearchPlannerAgent
+from super_crawler.cli import plan_to_crawl_config
+from super_crawler.dashboard import search_plan_block
+from super_crawler.llm import LLMUnavailable
+from super_crawler.seed import SAMPLE_REDDIT_ITEMS
+from super_crawler.storage import Storage
+
+
+class FakeLLM:
+    def __init__(self):
+        self.prompts: list[str] = []
+
+    def generate_json(self, prompt: str, system: str | None = None) -> dict:
+        self.prompts.append(prompt)
+        return {
+            "dimensions": ["tool requests", "complaints"],
+            "queries": [
+                {"query": "is there an app for dog medication schedules", "rationale": "tool request"},
+                "dog medication tracking frustrating",
+            ],
+            "sources": ["r/dogs", "r/AskVet"],
+            "negative_keywords": ["human medication"],
+            "validation_hypotheses": ["owners of multiple pets feel the pain most"],
+        }
+
+    def engine_name(self) -> str:
+        return "fake:test-model"
+
+
+class FailingLLM:
+    def generate_json(self, prompt: str, system: str | None = None) -> dict:
+        raise LLMUnavailable("server down")
+
+    def engine_name(self) -> str:
+        return "fake:down"
+
+
+class PlannerTests(unittest.TestCase):
+    def _storage(self) -> Storage:
+        directory = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, directory, True)
+        storage = Storage(Path(directory) / "test.sqlite3")
+        storage.migrate()
+        self.addCleanup(storage.close)
+        return storage
+
+    def test_llm_plan_is_saved_with_engine_and_coerced_queries(self) -> None:
+        storage = self._storage()
+        fake = FakeLLM()
+        plan = SearchPlannerAgent(storage, "planner-1", fake).plan(goal="dog medication tracking")
+
+        saved = storage.latest_search_plan()
