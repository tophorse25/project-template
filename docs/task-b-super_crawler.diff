+def plan_to_crawl_config(plan: SearchPlan, output_path: str) -> Path:
+    """Export a search plan as a crawl config for the project-template Reddit collector.
+
+    This is the bridge that makes plans actionable: the collector runs the planner's
+    queries live and its JSONL output can be ingested back into this system's inbox.
+    """
+
+    slug = slugify(plan.goal)[:40]
+    config = {
+        "product": plan.goal,
+        "queries": [item["query"] for item in plan.queries],
+        "sort": "relevance",
+        "limit_per_query": 20,
+        "output_path": f"data/raw/{slug}.jsonl",
+        "report_path": f"reports/{slug}.md",
+    }
+    path = Path(output_path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(config, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+    return path
