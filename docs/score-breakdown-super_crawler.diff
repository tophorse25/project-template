+def _score_bar(value: float, width_px: int = 90) -> str:
+    pct = max(0.0, min(100.0, float(value)))
+    filled = int(pct / 100 * width_px)
+    return (
+        f"<span style='display:inline-block;vertical-align:middle;width:{width_px}px;height:8px;"
+        f"background:#e2e8f0;border-radius:4px;overflow:hidden'>"
+        f"<span style='display:block;width:{filled}px;height:8px;background:#3a7bd5'></span></span>"
+    )
+
+
+def score_breakdown(scores: dict, compact: bool = False) -> str:
+    """Show every demand-signal component, not just the blended overall.
+
+    The single number hides what's driving it; this lets a reviewer decide what matters.
+    """
+    if not scores:
+        return "<div class='summary muted'>No score yet.</div>"
+
+    if compact:
+        chips = "".join(
+            f"<div class='summary'>{html.escape(label.split(' (')[0])}: "
+            f"<strong>{scores.get(key, 0)}</strong> {_score_bar(scores.get(key, 0), 60)}</div>"
+            for key, label, _weight in SCORE_DIMENSIONS
+        )
+        return f"<div class='scorebreak'>{chips}</div>"
+
+    rows = "".join(
+        f"<tr><td>{html.escape(label)}</td>"
+        f"<td>{_score_bar(scores.get(key, 0))}</td>"
+        f"<td>{scores.get(key, 0)}</td>"
+        f"<td class='muted'>{int(weight * 100)}% &rarr; +{round(scores.get(key, 0) * weight, 1)}</td></tr>"
+        for key, label, weight in SCORE_DIMENSIONS
+    )
+    overall = scores.get("overall_score", 0)
+    label = scores.get("overall_label", "")
+    return (
+        f"<p class='muted'>Overall <strong>{overall}</strong> ({html.escape(str(label))}) is a weighted blend. "
+        "The components below show what's actually driving it — judge them directly.</p>"
+        "<table class='breakdown'><thead><tr><th>Signal</th><th>Strength (0&ndash;100)</th>"
+        "<th>Value</th><th>Weight &rarr; contribution</th></tr></thead>"
+        f"<tbody>{rows}</tbody></table>"
+    )
+
+
