diff --git a/tests/test_score_breakdown.py b/tests/test_score_breakdown.py
new file mode 100644
index 0000000..b322c13
--- /dev/null
+++ b/tests/test_score_breakdown.py
@@ -0,0 +1,58 @@
+"""Show-all-components scoring (mentor feedback): display every sub-score, not just the blend."""
+
+from __future__ import annotations
+
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+
+from super_crawler.agents import SCORE_DIMENSIONS, DiscoveryAgent, PoolManagerAgent, score_requirement
+from super_crawler.dashboard import score_breakdown
+from super_crawler.seed import SAMPLE_REDDIT_ITEMS
+from super_crawler.storage import Storage
+
+
+class ScoreBreakdownTests(unittest.TestCase):
+    def _storage(self) -> Storage:
+        directory = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, directory, True)
+        storage = Storage(Path(directory) / "test.sqlite3")
+        storage.migrate()
+        self.addCleanup(storage.close)
+        return storage
+
+    def test_weights_sum_to_one(self) -> None:
+        self.assertAlmostEqual(sum(weight for _key, _label, weight in SCORE_DIMENSIONS), 1.0, places=6)
+
+    def test_refactor_matches_explicit_weighted_sum(self) -> None:
+        storage = self._storage()
+        DiscoveryAgent(storage, "discovery").ingest_reddit_items(SAMPLE_REDDIT_ITEMS)
+        PoolManagerAgent(storage, "pool").reconcile_candidates()
+        for requirement in storage.list_requirements():
+            scores = score_requirement(requirement, storage.list_evidence(requirement.evidence_ids))
+            expected = round(sum(scores[key] * weight for key, _label, weight in SCORE_DIMENSIONS), 1)
+            # overall must equal the weighted blend of the displayed component values
+            self.assertAlmostEqual(scores["overall_score"], expected, places=1)
+
+    def test_full_breakdown_lists_every_component(self) -> None:
+        scores = {key: 50 for key, _l, _w in SCORE_DIMENSIONS}
+        scores.update({"overall_score": 50.0, "overall_label": "watch_signal"})
+        html = score_breakdown(scores)
+        for _key, label, _weight in SCORE_DIMENSIONS:
+            self.assertIn(label, html)
+        self.assertIn("contribution", html)
+
+    def test_compact_breakdown_shows_components(self) -> None:
+        scores = {key: 30 for key, _l, _w in SCORE_DIMENSIONS}
+        scores.update({"overall_score": 30.0, "overall_label": "weak_signal"})
+        html = score_breakdown(scores, compact=True)
+        self.assertIn("Pain intensity", html)
+        self.assertIn("Willingness to pay", html)
+
+    def test_empty_scores_render_safely(self) -> None:
+        self.assertIn("No score yet", score_breakdown({}))
+
+
+if __name__ == "__main__":
+    unittest.main()
