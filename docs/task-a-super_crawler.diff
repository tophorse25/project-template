+def deep_workers_panel(storage: Storage, stale_after_seconds: float = 300.0) -> str:
+    """Real worker state: stage, current requirement, heartbeat age.
+
+    This is the truth panel — driven by the workers table that workers heartbeat into,
+    not inferred from queue rows. A queue item is not an agent.
+    """
+    workers = storage.list_workers()
+    if not workers:
+        rows = "<p class='muted'>No worker has run yet. Worker state appears after the first deep research cycle.</p>"
+    else:
+        items = []
+        for worker in workers:
+            age = worker["heartbeat_age_seconds"]
+            busy = worker["stage"] != "idle"
+            stale = busy and age > stale_after_seconds
+            freshness = "STALE — recovery will requeue its task" if stale else f"heartbeat {age:.0f}s ago"
+            status_class = "status running" if busy and not stale else "status"
+            requirement = worker["current_requirement_id"]
+            requirement_html = (
+                f"<a href='/requirement?id={html.escape(requirement)}'>{html.escape(requirement)}</a>"
+                if requirement
+                else "—"
+            )
+            error_html = (
+                f"<div class='summary'>last error: {html.escape(str(worker['last_error']))}</div>"
+                if worker["last_error"]
+                else ""
+            )
+            items.append(
+                f"""
+                <div class="item">
+                  <div class="title">{html.escape(worker["worker_id"])}</div>
+                  <div><span class="{status_class}">{html.escape(worker["stage"])}</span></div>
+                  <div class="summary">requirement: {requirement_html}</div>
+                  <div class="summary">{html.escape(freshness)}</div>
+                  {error_html}
+                </div>
+                """
+            )
+        rows = "".join(items)
+    return (
+        "<section class='panel'><h2>Deep Workers (real state)</h2>"
+        "<p class='muted'>Each worker reports its actual stage and heartbeat. Stale workers are recovered automatically.</p>"
+        + rows
+        + "</section>"
+    )
+
