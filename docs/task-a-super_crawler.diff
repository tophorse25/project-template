+    def update_worker_state(
+        self,
+        worker_id: str,
+        stage: str,
+        requirement_id: str | None = None,
+        role: str = "deep_research",
+        error: str | None = None,
+    ) -> None:
+        """Record a worker's real stage + heartbeat. Each call IS the heartbeat."""
+
+        now = utc_now()
+        self.conn.execute(
+            """
+            INSERT INTO workers (worker_id, role, stage, current_requirement_id, started_at, heartbeat_at, last_error)
+            VALUES (?, ?, ?, ?, ?, ?, ?)
+            ON CONFLICT(worker_id) DO UPDATE SET
+                role=excluded.role,
+                stage=excluded.stage,
+                current_requirement_id=excluded.current_requirement_id,
+                heartbeat_at=excluded.heartbeat_at,
+                last_error=excluded.last_error
+            """,
+            (worker_id, role, stage, requirement_id, now, now, error),
+        )
+        self.conn.commit()
+
+    def mark_worker_idle(self, worker_id: str, error: str | None = None) -> None:
+        self.update_worker_state(worker_id, "idle", requirement_id=None, error=error)
+
+    def list_workers(self) -> list[dict[str, Any]]:
+        rows = self.conn.execute("SELECT * FROM workers ORDER BY heartbeat_at DESC").fetchall()
+        workers = []
+        for row in rows:
+            item = dict(row)
+            item["heartbeat_age_seconds"] = round(self._seconds_since(item["heartbeat_at"]), 1)
+            workers.append(item)
+        return workers
+
+    def _seconds_since(self, iso_timestamp: str) -> float:
+        try:
+            then = datetime.fromisoformat(iso_timestamp)
+        except (TypeError, ValueError):
+            return float("inf")
+        return (datetime.now(UTC) - then).total_seconds()
