diff --git a/tests/test_workers.py b/tests/test_workers.py
new file mode 100644
index 0000000..fea24bb
--- /dev/null
+++ b/tests/test_workers.py
@@ -0,0 +1,110 @@
+"""Task A — real worker state, heartbeats, and the status panel.
+
+The deck's principle (slides 5-7): items in the queue are not agents; which agents are
+running must come from real worker state, and the dashboard must show that state. These
+tests cover the worker lifecycle, heartbeat-aware recovery, and the panel rendering.
+Teardown is Windows-safe (close connections before removing the temp dir).
+"""
+
+from __future__ import annotations
+
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from super_crawler.agents import DeepResearchAgent, DiscoveryAgent, PoolManagerAgent
+from super_crawler.dashboard import deep_workers_panel
+from super_crawler.models import RequirementStatus
+from super_crawler.seed import SAMPLE_REDDIT_ITEMS
+from super_crawler.storage import Storage
+
+
+class WorkerStateTests(unittest.TestCase):
+    def _storage(self) -> Storage:
+        directory = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, directory, True)
+        storage = Storage(Path(directory) / "test.sqlite3")
+        storage.migrate()
+        self.addCleanup(storage.close)
+        return storage
+
+    def _seed_queue(self, storage: Storage) -> None:
+        DiscoveryAgent(storage, "discovery").ingest_reddit_items(SAMPLE_REDDIT_ITEMS)
+        PoolManagerAgent(storage, "pool").reconcile_candidates()
+        self.assertTrue(storage.list_queue())
+
+    def test_worker_state_records_stage_requirement_and_heartbeat(self) -> None:
+        storage = self._storage()
+        storage.update_worker_state("worker-1", "scoring", "REQ-X")
+        workers = storage.list_workers()
+        self.assertEqual(len(workers), 1)
+        worker = workers[0]
+        self.assertEqual(worker["stage"], "scoring")
+        self.assertEqual(worker["current_requirement_id"], "REQ-X")
+        self.assertLess(worker["heartbeat_age_seconds"], 5.0)
+
+    def test_completed_research_leaves_worker_idle(self) -> None:
+        storage = self._storage()
+        self._seed_queue(storage)
+        run = DeepResearchAgent(storage, "worker-1").run_next()
+        self.assertIsNotNone(run)
+        worker = storage.list_workers()[0]
+        self.assertEqual(worker["stage"], "idle")
+        self.assertIsNone(worker["current_requirement_id"])
+        self.assertIsNone(worker["last_error"])
+
+    def test_failed_research_marks_worker_idle_with_error(self) -> None:
+        storage = self._storage()
+        self._seed_queue(storage)
+        agent = DeepResearchAgent(storage, "worker-1")
+        with patch.object(DeepResearchAgent, "research", side_effect=RuntimeError("LLM timeout")):
+            self.assertIsNone(agent.run_next())
+        worker = storage.list_workers()[0]
+        self.assertEqual(worker["stage"], "idle")
+        self.assertIn("LLM timeout", worker["last_error"])
+
+    def test_reaper_skips_requirement_held_by_fresh_worker(self) -> None:
+        storage = self._storage()
+        self._seed_queue(storage)
+        rid = storage.lock_next_research("worker-1")
+        requirement = storage.get_requirement(rid)
+        requirement.status = RequirementStatus.RESEARCHING
+        storage.upsert_requirement(requirement)
+        storage.update_worker_state("worker-1", "scoring", rid)  # fresh heartbeat
+
+        recovered = storage.requeue_orphaned_research(stale_after_seconds=300.0)
+
+        self.assertNotIn(rid, recovered)
+        self.assertEqual(storage.get_requirement(rid).status, RequirementStatus.RESEARCHING)
+
+    def test_reaper_reclaims_requirement_with_stale_heartbeat(self) -> None:
+        storage = self._storage()
+        self._seed_queue(storage)
+        rid = storage.lock_next_research("worker-1")
+        requirement = storage.get_requirement(rid)
+        requirement.status = RequirementStatus.RESEARCHING
+        storage.upsert_requirement(requirement)
+        storage.update_worker_state("worker-1", "scoring", rid)
+
+        # stale_after=0 means any heartbeat age counts as stale.
+        recovered = storage.requeue_orphaned_research(stale_after_seconds=0.0)
+
+        self.assertIn(rid, recovered)
+        self.assertEqual(storage.get_requirement(rid).status, RequirementStatus.QUEUED_FOR_RESEARCH)
+        self.assertEqual(storage.lock_next_research("worker-2"), rid)
+
+    def test_dashboard_panel_shows_real_worker_state(self) -> None:
+        storage = self._storage()
+        storage.update_worker_state("deep-worker-3", "synthesizing", "REQ-2026-000001")
+        html = deep_workers_panel(storage)
+        self.assertIn("Deep Workers (real state)", html)
+        self.assertIn("deep-worker-3", html)
+        self.assertIn("synthesizing", html)
+        self.assertIn("REQ-2026-000001", html)
+        self.assertIn("heartbeat", html)
+
+
+if __name__ == "__main__":
+    unittest.main()
