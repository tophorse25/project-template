diff --git a/tests/test_recovery.py b/tests/test_recovery.py
new file mode 100644
index 0000000..8fd0730
--- /dev/null
+++ b/tests/test_recovery.py
@@ -0,0 +1,102 @@
+"""Task C — failure recovery & state-machine integrity.
+
+Reproducible tests for the production failure modes the training deck calls out (slide 6):
+crashed/stuck `researching`, double-claim races, DB-lock contention. Teardown is
+Windows-safe: connections are closed (LIFO addCleanup) before the temp dir is removed.
+"""
+
+from __future__ import annotations
+
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from super_crawler.agents import DeepResearchAgent, DiscoveryAgent, PoolManagerAgent
+from super_crawler.models import RequirementStatus
+from super_crawler.seed import SAMPLE_REDDIT_ITEMS
+from super_crawler.storage import Storage
+
+
+class RecoveryTests(unittest.TestCase):
+    def _storage(self) -> Storage:
+        directory = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, directory, True)  # LIFO: runs last
+        storage = Storage(Path(directory) / "test.sqlite3")
+        storage.migrate()
+        self.addCleanup(storage.close)  # LIFO: runs first, unlocks the file before rmtree
+        return storage
+
+    def _seed_queue(self, storage: Storage) -> None:
+        DiscoveryAgent(storage, "discovery").ingest_reddit_items(SAMPLE_REDDIT_ITEMS)
+        PoolManagerAgent(storage, "pool").reconcile_candidates()
+        self.assertTrue(storage.list_queue())  # precondition: something is queued
+
+    def test_wal_is_enabled(self) -> None:
+        storage = self._storage()
+        mode = storage.conn.execute("PRAGMA journal_mode").fetchone()[0]
+        self.assertEqual(mode.lower(), "wal")
+
+    def test_atomic_claim_prevents_double_lock(self) -> None:
+        storage = self._storage()
+        self._seed_queue(storage)
+        first = storage.lock_next_research("worker-a")
+        self.assertIsNotNone(first)
+        # A different worker must never be handed the same requirement.
+        second = storage.lock_next_research("worker-b")
+        self.assertNotEqual(first, second)
+
+    def test_reaper_requeues_orphaned_researching(self) -> None:
+        storage = self._storage()
+        self._seed_queue(storage)
+        rid = storage.lock_next_research("worker-a")
+        self.assertIsNotNone(rid)
+
+        # Simulate a worker that flipped to `researching` and then died mid-run.
+        requirement = storage.get_requirement(rid)
+        requirement.status = RequirementStatus.RESEARCHING
+        requirement.assigned_to = "worker-a"
+        storage.upsert_requirement(requirement)
+
+        recovered = storage.requeue_orphaned_research()
+        self.assertIn(rid, recovered)
+
+        healed = storage.get_requirement(rid)
+        self.assertEqual(healed.status, RequirementStatus.QUEUED_FOR_RESEARCH)
+        self.assertIsNone(healed.assigned_to)
+        # ...and it is claimable again.
+        self.assertEqual(storage.lock_next_research("worker-b"), rid)
+
+    def test_failed_research_is_requeued_not_stuck(self) -> None:
+        storage = self._storage()
+        self._seed_queue(storage)
+        agent = DeepResearchAgent(storage, "worker-a")
+
+        # Deep research blows up (e.g. LLM timeout / OpenCLI failure).
+        with patch.object(DeepResearchAgent, "research", side_effect=RuntimeError("LLM timeout")):
+            result = agent.run_next()
+
+        self.assertIsNone(result)
+        stuck = [r for r in storage.list_requirements() if r.status == RequirementStatus.RESEARCHING]
+        self.assertEqual(stuck, [])  # nothing stranded
+        self.assertIsNotNone(storage.lock_next_research("worker-b"))  # back in the queue
+
+    def test_recovery_is_idempotent(self) -> None:
+        storage = self._storage()
+        self._seed_queue(storage)
+        rid = storage.lock_next_research("worker-a")
+        requirement = storage.get_requirement(rid)
+        requirement.status = RequirementStatus.RESEARCHING
+        storage.upsert_requirement(requirement)
+
+        # Running the reaper twice must not create duplicate queue rows or dirty state.
+        storage.requeue_orphaned_research()
+        queue_after_first = len(storage.list_queue())
+        storage.requeue_orphaned_research()
+        queue_after_second = len(storage.list_queue())
+        self.assertEqual(queue_after_first, queue_after_second)
+
+
+if __name__ == "__main__":
+    unittest.main()
