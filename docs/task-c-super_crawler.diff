+    def requeue_orphaned_research(self) -> list[str]:
+        """Recover requirements stuck in ``researching`` after a worker/process died mid-run.
+
+        Resets each to ``queued_for_research``, clears the assignee, and unlocks (or
+        re-creates) its queue row so another worker can claim it. Safe to call at the start
+        of a cycle: anything still ``researching`` then has no live worker holding it.
+        Returns the recovered requirement ids.
+        """
+        rows = self.conn.execute(
+            "SELECT requirement_id FROM requirements WHERE status=?",
+            (RequirementStatus.RESEARCHING.value,),
+        ).fetchall()
+        recovered: list[str] = []
+        for row in rows:
+            self._requeue(row["requirement_id"], reason="recovered_orphaned_research")
+            recovered.append(row["requirement_id"])
+        return recovered
+
+    def recover_failed_research(self, requirement_id: str, error: str) -> None:
+        """A deep-research attempt raised; re-queue the requirement instead of stranding it."""
+
+        self._requeue(requirement_id, reason="research_failed", error=error)
+
+    def _requeue(self, requirement_id: str, reason: str, error: str | None = None) -> None:
+        now = utc_now()
+        requirement = self.get_requirement(requirement_id)
+        if requirement is not None:
+            requirement.status = RequirementStatus.QUEUED_FOR_RESEARCH
+            requirement.assigned_to = None
+            event: dict[str, Any] = {"at": now, "decision": reason}
+            if error:
+                event["error"] = error
+            requirement.decision_history.append(event)
+            self.upsert_requirement(requirement)
+        # Unlock an existing queue row, or recreate one if it was already dequeued.
+        cursor = self.conn.execute(
+            "UPDATE research_queue SET locked_by=NULL, assigned_agent=NULL, updated_at=? WHERE requirement_id=?",
+            (now, requirement_id),
+        )
+        self.conn.commit()
+        if cursor.rowcount == 0 and requirement is not None:
+            self.enqueue_research(
+                requirement_id=requirement_id,
+                priority=int(requirement.current_scores.get("overall_score", 50)),
+                reason=reason,
+                new_evidence_count=0,
+                previous_research_status=requirement.latest_recommendation,
+            )
