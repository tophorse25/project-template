index 0000000..e163587
--- /dev/null
+++ b/tests/test_client_report.py
@@ -0,0 +1,82 @@
+"""Task D - customer-readable opportunity briefs."""
+
+from __future__ import annotations
+
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+
+from super_crawler.agents import DeepResearchAgent, DiscoveryAgent, PoolManagerAgent
+from super_crawler.client_report import render_client_overview, render_client_page
+from super_crawler.models import RequirementStatus
+from super_crawler.seed import SAMPLE_REDDIT_ITEMS
+from super_crawler.storage import Storage
+
+
+class ClientReportTests(unittest.TestCase):
+    def _storage(self) -> Storage:
+        directory = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, directory, True)
+        storage = Storage(Path(directory) / "test.sqlite3")
+        storage.migrate()
+        self.addCleanup(storage.close)
+        return storage
+
+    def _seed_and_research(self, storage: Storage) -> list:
+        DiscoveryAgent(storage, "discovery").ingest_reddit_items(SAMPLE_REDDIT_ITEMS)
+        PoolManagerAgent(storage, "pool").reconcile_candidates()
+        while DeepResearchAgent(storage, "worker").run_next() is not None:
+            pass
+        return storage.list_requirements()
+
+    def test_single_brief_has_all_customer_sections(self) -> None:
+        storage = self._storage()
+        requirements = self._seed_and_research(storage)
+        researched = next(r for r in requirements if r.research_history)
+
+        page = render_client_page(storage, researched.requirement_id)
+
+        self.assertTrue(page.startswith("<!doctype html>"))
+        for section in ["Why we believe this is real", "Suggested next step", "Source evidence", "Limitations"]:
+            self.assertIn(section, page)
+        self.assertIn("https://reddit.com", page)  # evidence links survive
+        # No internal jargon on a customer page.
+        for jargon in ["queued_for_research", "candidate_id", "agent_id", "Pool Manager"]:
+            self.assertNotIn(jargon, page)
+
+    def test_verdict_language_is_plain(self) -> None:
+        storage = self._storage()
+        requirements = self._seed_and_research(storage)
+        rejected = next((r for r in requirements if r.status == RequirementStatus.REJECTED), None)
+        if rejected is None:
+            self.skipTest("no rejected requirement in seed outcomes")
+        page = render_client_page(storage, rejected.requirement_id)
+        self.assertIn("Not enough evidence", page)
+
+    def test_overview_lists_researched_requirements_with_links(self) -> None:
+        storage = self._storage()
+        requirements = self._seed_and_research(storage)
+        researched = [r for r in requirements if r.research_history]
+
+        page = render_client_overview(storage)
+
+        self.assertIn("Opportunity reports", page)
+        for requirement in researched:
+            self.assertIn(f"/client-report?id={requirement.requirement_id}", page)
+
+    def test_unknown_requirement_renders_not_found(self) -> None:
+        storage = self._storage()
+        page = render_client_page(storage, "REQ-NOPE")
+        self.assertIn("Report not found", page)
+
+    def test_boilerplate_title_prefix_is_stripped(self) -> None:
+        storage = self._storage()
+        requirements = self._seed_and_research(storage)
+        researched = next(r for r in requirements if r.research_history)
+        page = render_client_page(storage, researched.requirement_id)
+        self.assertNotIn("Users need a better way to handle", page.split("<h1>")[1].split("</h1>")[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
