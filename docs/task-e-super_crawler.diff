diff --git a/tests/test_metrics.py b/tests/test_metrics.py
new file mode 100644
index 0000000..332e7c4
--- /dev/null
+++ b/tests/test_metrics.py
@@ -0,0 +1,110 @@
+"""Task E - evaluation metrics: speed, cost, relevance, validated rate."""
+
+from __future__ import annotations
+
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+
+from super_crawler.agents import DeepResearchAgent, DiscoveryAgent, PoolManagerAgent, SearchPlannerAgent
+from super_crawler.dashboard import metrics_panel
+from super_crawler.metrics import compute_metrics
+from super_crawler.models import SearchPlan
+from super_crawler.seed import SAMPLE_REDDIT_ITEMS
+from super_crawler.storage import Storage
+
+
+def make_plan(plan_id: str, engine: str, llm_seconds: float) -> SearchPlan:
+    return SearchPlan(
+        plan_id=plan_id,
+        task_group_id=None,
+        goal="test goal",
+        engine=engine,
+        dimensions=["d"],
+        queries=[{"query": "q", "rationale": ""}],
+        sources=[],
+        negative_keywords=[],
+        validation_hypotheses=[],
+        feedback_summary="",
+        created_at="2026-06-11T00:00:00+00:00",
+        llm_seconds=llm_seconds,
+    )
+
+
+class MetricsTests(unittest.TestCase):
+    def _storage(self) -> Storage:
+        directory = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, directory, True)
+        storage = Storage(Path(directory) / "test.sqlite3")
+        storage.migrate()
+        self.addCleanup(storage.close)
+        return storage
+
+    def _seed_and_research(self, storage: Storage) -> None:
+        DiscoveryAgent(storage, "discovery").ingest_reddit_items(SAMPLE_REDDIT_ITEMS)
+        PoolManagerAgent(storage, "pool").reconcile_candidates()
+        while DeepResearchAgent(storage, "worker").run_next() is not None:
+            pass
+
+    def test_validated_rate_and_relevance_from_requirement_outcomes(self) -> None:
+        storage = self._storage()
+        self._seed_and_research(storage)
+
+        metrics = compute_metrics(storage)
+
+        researched = metrics["validated_rate"]["researched"]
+        self.assertGreater(researched, 0)
+        rate = metrics["validated_rate"]["rate"]
+        self.assertTrue(0.0 <= rate <= 1.0)
+        # noise + signal account for all researched outcomes (statuses are exhaustive here)
+        noise = metrics["relevance"]["noise_rate"] or 0.0
+        signal = metrics["relevance"]["signal_rate"] or 0.0
+        self.assertAlmostEqual(noise + signal, 1.0, places=2)
+
+    def test_speed_uses_pipeline_timestamps(self) -> None:
+        storage = self._storage()
+        storage.save_pipeline_run(
+            pipeline_run_id="pipe_1",
+            started_at="2026-06-11T00:00:00+00:00",
+            completed_at="2026-06-11T00:01:00+00:00",
+            status="completed",
+            result={"items_loaded": 10, "candidates": 4},
+            summary="test",
+        )
+
+        metrics = compute_metrics(storage)
+
+        self.assertEqual(metrics["speed"]["cycles"], 1)
+        self.assertEqual(metrics["speed"]["avg_cycle_seconds"], 60.0)
+        self.assertEqual(metrics["relevance"]["discovery_yield"], 0.4)
+
+    def test_cost_aggregates_llm_seconds_from_plans(self) -> None:
+        storage = self._storage()
+        storage.upsert_search_plan(make_plan("p1", "ollama:qwen2.5:3b", 12.5))
+        storage.upsert_search_plan(make_plan("p2", "ollama:qwen2.5:3b", 7.5))
+        storage.upsert_search_plan(make_plan("p3", "heuristic", 0.0))
+
+        cost = compute_metrics(storage)["cost"]
+
+        self.assertEqual(cost["llm_plan_calls"], 2)
+        self.assertEqual(cost["llm_seconds_total"], 20.0)
+        self.assertEqual(cost["heuristic_plan_calls"], 1)
+
+    def test_heuristic_plan_records_zero_llm_seconds(self) -> None:
+        storage = self._storage()
+        plan = SearchPlannerAgent(storage, "planner", client=None).plan(goal="anything")
+        self.assertEqual(plan.llm_seconds, 0.0)
+
+    def test_dashboard_panel_renders_metric_cards(self) -> None:
+        storage = self._storage()
+        self._seed_and_research(storage)
+        html = metrics_panel(storage)
+        self.assertIn("Evaluation Metrics", html)
+        self.assertIn("Validated rate", html)
+        self.assertIn("Signal rate", html)
+        self.assertIn("/api/metrics", html)
+
+
+if __name__ == "__main__":
+    unittest.main()
