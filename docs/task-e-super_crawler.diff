diff --git a/super_crawler/metrics.py b/super_crawler/metrics.py
new file mode 100644
index 0000000..136d8ee
--- /dev/null
+++ b/super_crawler/metrics.py
@@ -0,0 +1,108 @@
+"""Task E - evaluation metrics: speed, cost, relevance, validated rate.
+
+Everything is computed from data the system already records (pipeline runs,
+research runs, requirement statuses, search plans, activity logs) - no separate
+bookkeeping to keep in sync. Local LLM cost is reported as compute seconds and
+call counts, not dollars: that is the honest unit for an on-device model.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime
+from typing import Any
+
+from .models import RequirementStatus
+from .storage import Storage
+
+
+def _seconds_between(started_at: str | None, completed_at: str | None) -> float | None:
+    if not started_at or not completed_at:
+        return None
+    try:
+        start = datetime.fromisoformat(started_at)
+        end = datetime.fromisoformat(completed_at)
+    except ValueError:
+        return None
+    return max((end - start).total_seconds(), 0.0)
+
+
+def _round(value: float | None, digits: int = 2) -> float | None:
+    return None if value is None else round(value, digits)
+
+
+def compute_metrics(storage: Storage) -> dict[str, Any]:
+    pipelines = storage.list_pipeline_runs(limit=200)
+    research_runs = storage.list_research_runs()
+    requirements = storage.list_requirements()
+    plans = storage.list_search_plans(limit=200)
+
+    # --- speed ---------------------------------------------------------------
+    cycle_durations = [d for run in pipelines if (d := _seconds_between(run.get("started_at"), run.get("completed_at"))) is not None]
+    research_durations = [d for run in research_runs if (d := _seconds_between(run.started_at, run.completed_at)) is not None]
+    speed = {
+        "cycles": len(pipelines),
+        "avg_cycle_seconds": _round(sum(cycle_durations) / len(cycle_durations)) if cycle_durations else None,
+        "last_cycle_seconds": _round(cycle_durations[0]) if cycle_durations else None,
+        "research_runs": len(research_runs),
+        "avg_research_seconds": _round(sum(research_durations) / len(research_durations)) if research_durations else None,
+    }
+
+    # --- cost ----------------------------------------------------------------
+    llm_plans = [plan for plan in plans if plan.engine.startswith("ollama")]
+    heuristic_plans = [plan for plan in plans if plan.engine == "heuristic"]
+    activity_cost = 0.0
+    for log in storage.list_activity_logs(limit=1000):
+        activity_cost += float(log.get("cost_estimate") or 0.0)
+    cost = {
+        "llm_plan_calls": len(llm_plans),
+        "llm_seconds_total": _round(sum(getattr(plan, "llm_seconds", 0.0) for plan in llm_plans)),
+        "heuristic_plan_calls": len(heuristic_plans),
+        "agent_cost_estimate_total": _round(activity_cost),
+        "note": "local model: cost is compute seconds, not dollars",
+    }
+
+    # --- relevance -----------------------------------------------------------
+    items_seen = 0
+    candidates_created = 0
+    per_cycle: list[dict[str, Any]] = []
+    for run in pipelines[:10]:
+        result = run.get("result") or {}
+        items = int(result.get("items_loaded") or 0)
+        cands = int(result.get("candidates") or 0)
+        items_seen += items
+        candidates_created += cands
+        per_cycle.append(
+            {
+                "at": run.get("completed_at"),
+                "items_loaded": items,
+                "candidates": cands,
+                "seconds": _round(_seconds_between(run.get("started_at"), run.get("completed_at"))),
+            }
+        )
+
+    by_status = {status.value: 0 for status in RequirementStatus}
+    for requirement in requirements:
+        by_status[requirement.status.value] = by_status.get(requirement.status.value, 0) + 1
+    researched = [r for r in requirements if r.research_history]
+    rejected = sum(1 for r in researched if r.status == RequirementStatus.REJECTED)
+    signal = sum(1 for r in researched if r.status in {RequirementStatus.VALIDATED, RequirementStatus.WATCHING})
+    relevance = {
+        "items_seen_recent": items_seen,
+        "candidates_recent": candidates_created,
+        "discovery_yield": _round(candidates_created / items_seen, 3) if items_seen else None,
+        "researched": len(researched),
+        "noise_rate": _round(rejected / len(researched), 3) if researched else None,
+        "signal_rate": _round(signal / len(researched), 3) if researched else None,
+        "by_status": {status: count for status, count in by_status.items() if count},
+        "recent_cycles": per_cycle,
+    }
+
+    # --- validated rate --------------------------------------------------------
+    validated = by_status.get(RequirementStatus.VALIDATED.value, 0)
+    validated_rate = {
+        "validated": validated,
+        "researched": len(researched),
+        "rate": _round(validated / len(researched), 3) if researched else None,
+    }
+
+    return {"speed": speed, "cost": cost, "relevance": relevance, "validated_rate": validated_rate}
